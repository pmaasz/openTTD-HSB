@@ -0,0 +1,42 @@
+#ifndef HSB_BUILDER_H
+#define HSB_BUILDER_H
+
+/**
+ * HSB headless scenario builder.
+ *
+ * Driven by the HSB_BUILD environment variable pointing at a JSON manifest:
+ * {
+ *   "heightmap":  "/abs/path/map-4096.png",
+ *   "towns":      "/abs/path/towns.json",
+ *   "industries": "/abs/path/industries.json",
+ *   "rivers":     "/abs/path/rivers.json",   // optional, omit or null to skip
+ *   "bounds":     {"lat_min": 47.0, "lat_max": 55.5,
+ *                  "lon_min": 4.0,  "lon_max": 15.5},
+ *   "start_year": 2025,
+ *   "heightmap_height": 12,                  // optional, default 12
+ *   "heightmap_rotation": "clockwise",       // optional: clockwise (default)
+ *                                            // or counter-clockwise
+ *   "seed": 20250924,                        // optional, fixed generation seed (not 0xffffffff)
+ *   "industry_search_radius": 32,            // optional 1..512 spiral fallback tiles
+ *   "save":       "output.scn"
+ * }
+ * heightmap/towns are resolved by basename through the engine file search
+ * (scenario/heightmap in the personal dir); industries/rivers manifests are
+ * read directly; save goes to the scenario dir.
+ *
+ * Run: HSB_BUILD=manifest.json openttd -e -c <config>
+ * (config must activate the wanted NewGRFs first).
+ *
+ * Old manifests without "bounds" are rejected with a clear error — add the
+ * geographic bounds your heightmap/towns were built with (see
+ * scripts/build-manifest.py).
+ *
+ * This file is part of openTTD-HSB.
+ * Licensed under the GNU General Public License, version 2.
+ * See LICENSE.md for details.
+ */
+
+bool HsbBuildRequested();
+bool HsbBuildScenario();
+
+#endif /* HSB_BUILDER_H */
diff --git a/src/hsb_builder_math.h b/src/hsb_builder_math.h
new file mode 100644
index 0000000..14e2528
--- /dev/null
+++ b/src/hsb_builder_math.h
@@ -0,0 +1,54 @@
+#ifndef HSB_BUILDER_MATH_H
+#define HSB_BUILDER_MATH_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+struct HsbBounds {
+	double lat_min = 0.0;
+	double lat_max = 0.0;
+	double lon_min = 0.0;
+	double lon_max = 0.0;
+};
+
+struct HsbTile {
+	uint32_t x = 0;
+	uint32_t y = 0;
+};
+
+inline bool HsbIsPowerOfTwo(uint32_t value, uint32_t minimum, uint32_t maximum)
+{
+	return value >= minimum && value <= maximum && (value & (value - 1)) == 0;
+}
+
+inline bool HsbCoordinateInBounds(const HsbBounds &bounds, double lat, double lon)
+{
+	return std::isfinite(lat) && std::isfinite(lon)
+		&& bounds.lat_min <= lat && lat <= bounds.lat_max
+		&& bounds.lon_min <= lon && lon <= bounds.lon_max;
+}
+
+inline HsbTile HsbTileForBounds(const HsbBounds &bounds, double lat, double lon,
+	uint32_t max_x, uint32_t max_y, bool counter_clockwise)
+{
+	const double x_prop = (bounds.lat_max - lat) / (bounds.lat_max - bounds.lat_min);
+	const double y_prop = (lon - bounds.lon_min) / (bounds.lon_max - bounds.lon_min);
+	const double tile_x = counter_clockwise ? 1.0 - y_prop : x_prop;
+	const double tile_y = counter_clockwise ? x_prop : y_prop;
+	const long clamped_x = std::clamp(std::lround(tile_x * max_x), 0L, static_cast<long>(max_x));
+	const long clamped_y = std::clamp(std::lround(tile_y * max_y), 0L, static_cast<long>(max_y));
+	return {static_cast<uint32_t>(clamped_x), static_cast<uint32_t>(clamped_y)};
+}
+
+inline bool HsbSafeFilename(const std::string &filename)
+{
+	if (filename.empty() || filename == "." || filename == "..") return false;
+	return filename.find('\0') == std::string::npos
+		&& filename.find_first_of("/\\:") == std::string::npos
+		&& std::filesystem::path(filename).filename().string() == filename;
+}
+
+#endif
